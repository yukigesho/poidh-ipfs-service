# Preferred: JWT with permission to pin files and JSON on the EXISTING Pinata account.
PINATA_JWT=
# Alternatively use the existing service's credentials (never commit real values):
# PINATA_KEY=
# PINATA_SECRET=

# Required API access token, separate from Pinata. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Browser users can inspect/copy any token given to the frontend.
API_BEARER_TOKEN=

PORT=3001
ALLOWED_ORIGINS=https://poidh.xyz,https://*.poidh.xyz,http://localhost:3000
MAX_FILE_SIZE_BYTES=30485760
MAX_CONCURRENT_UPLOADS=4
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000
PINATA_TIMEOUT_MS=60000
# Direct local connections: 0. On Railway, verify proxy topology before changing.
TRUST_PROXY_HOPS=0
